MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/hotelmania
PORT=5001
# 32+ random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated front-end origins allowed by CORS
CLIENT_URL=http://localhost:5173
# Optional: persistent folder for uploaded images (defaults to Server/uploads)
UPLOAD_DIR=
# Only used by `node createAdmin.js`
ADMIN_EMAIL=
ADMIN_PASSWORD=
