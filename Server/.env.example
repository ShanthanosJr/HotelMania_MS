MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/hotelmania
PORT=5050
# 32+ random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated front-end origins allowed by CORS
CLIENT_URL=http://localhost:5173
# Optional: persistent folder for uploaded images (defaults to Server/uploads)
UPLOAD_DIR=
# Only used by `node createAdmin.js`
ADMIN_EMAIL=
ADMIN_PASSWORD=
# PayHere — merchant secret is per whitelisted domain (PayHere dashboard > Integrations)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
PAYHERE_CURRENCY=USD
# Public URL of this API that PayHere can POST payment notifications to (ngrok URL in dev)
PUBLIC_API_URL=
BOOKING_HOLD_MINUTES=30
# Charges added on top of the room rate, in percent (0 = none). Tax applies to room + service charge.
SERVICE_CHARGE_PERCENT=0
TAX_PERCENT=0
# Guest emails (booking confirmed / cancelled / refunded). Leave SMTP_HOST empty to log emails to the console instead.
HOTEL_NAME=HotelMania
MAIL_FROM="HotelMania <reservations@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Where Contact-form enquiries are emailed (defaults to SMTP_USER)
ENQUIRY_INBOX=

# Hotel's time zone, used for "today" at the front desk and in reports
HOTEL_TIMEZONE=Asia/Colombo
